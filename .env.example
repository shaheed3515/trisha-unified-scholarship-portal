# ═══════════════════════════════════════════════════════════
# TRISHA Backend — Environment Configuration
# ═══════════════════════════════════════════════════════════

# MongoDB Atlas Connection String
# Get this from: MongoDB Atlas → Connect → Drivers → Node.js
# Replace <username>, <password>, and <cluster-url> with your values
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/trisha?retryWrites=true&w=majority

# Server Port (default: 3001)
PORT=3001
